{
  "name": "capnodejs",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^10.0.5",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@humanwhocodes/momoa": "^3.3.10",
    "@prettier/plugin-xml": "^3.4.2",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.7.14",
    "@sap-ux/fiori-annotation-api": "^1.0.20",
    "@sap/cds-dk": "^10.0.6",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@ui5/linter": "^1.23.3",
    "cds-plugin-ui5": "^0.17.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "mbt": "^1.2.49",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "ui5-test-runner": "^5.13.1",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "npx cds deploy --to sqlite && cross-env CDS_PLUGIN_UI5_LAZY_LOADING=true npx cds-serve",
    "watch-testbooks": "cds watch --open testbooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy capnodejs --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "lint": "npm run eslint && npm run ui5lint && npm run cdslint",
    "fix": "npm run eslint:fix && npm run ui5lint:fix && npm run cdslint:fix && npm run format",
    "eslint": "npx eslint",
    "eslint:fix": "npx eslint --fix",
    "ui5lint": "cd app/testbooks && npx ui5lint --details --ignore-pattern \"webapp/manifest.json\"",
    "ui5lint:fix": "cd app/testbooks && npx ui5lint --fix",
    "cdslint": "npx cds lint db srv",
    "cdslint:fix": "npx cds lint db srv --fix",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "test": "npm run lint && npm run test:ui5",
    "test:testbooks": "concurrently -k --success first -n \"CAP,UI5\" -c \"blue,cyan\" \"npm run start\" \"wait-on http://localhost:4004 && npm --prefix app/testbooks run test\"",
    "test:cds": "npx cds deploy --to sqlite && npx cds test --verbose",
    "test:ui5": "concurrently -k --success first -n \"CAP,UI5\" -c \"blue,cyan\" \"npm run start\" \"wait-on http://localhost:4004 && npm run test-runner\"",
    "test-runner": "npx puppeteer browsers install chrome && npx ui5-test-runner"
  },
  "sapux": [
    "app/admin-books",
    "app/browse"
  ],
  "cds": {
    "requires": {
      "html5-repo": true,
      "application-logging": true,
      "auth": "dummy",
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}