{
  "name": "capnodejs",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^9.9.1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-types": "^0.18.0",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.6.5",
    "@sap/cds-dk": "^9.9.2",
    "@sap/eslint-plugin-cds": "^4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@ui5/linter": "^1.23.1",
    "cds-plugin-ui5": "^0.13.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "mbt": "^1.2.49",
    "prettier": "^3.8.4",
    "rimraf": "^5.0.5",
    "ui5-test-runner": "^5.13.1",
    "wait-on": "^9.0.10"
  },
  "scripts": {
    "start": "cds deploy --to sqlite && cds-serve",
    "watch-testbooks": "cds watch --open testbooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy capnodejs --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "lint": "npm run eslint && npm run ui5lint && npm run cdslint",
    "fix": "npm run eslint:fix && npm run ui5lint:fix && npm run cdslint:fix && npm run format",
    "eslint": "npx eslint",
    "eslint:fix": "npx eslint --fix",
    "ui5lint": "cd app/testbooks && npx ui5lint --details",
    "ui5lint:fix": "cd app/testbooks && npx ui5lint --fix",
    "cdslint": "npx cds lint db srv",
    "cdslint:fix": "npx cds lint db srv --fix",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "test": "npm run lint && npm run test:cds && npm run test:testbooks",
    "test:testbooks": "concurrently -k -n \"CAP,UI5\" -c \"blue,cyan\" \"npx cds-serve\" \"wait-on http://localhost:4004 && npm --prefix app/testbooks run test\"",
    "test:cds": "npx cds test",
    "test:ui5": "concurrently -k -n \"CAP,UI5\" -c \"blue,cyan\" \"npm run start\" \"wait-on http://localhost:4004 && npm run test-runner\"",
    "test-runner": "npx puppeteer browsers install chrome && ui5-test-runner"
  },
  "sapux": [
    "app/admin-books",
    "app/browse"
  ],
  "cds": {
    "requires": {
      "html5-repo": true,
      "application-logging": true,
      "auth": "dummy",
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}