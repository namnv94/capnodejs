{
  "name": "capnodejs",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@cap-js/sqlite": "^1"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.8.0",
    "@sap/cds-dk": "^8",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10"
  },
  "scripts": {
    "start": "cds deploy --to sqlite && cds-serve",
    "watch-testbooks": "cds watch --open testbooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy capnodejs --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "sapux": [
    "app/admin-books",
    "app/browse"
  ],
  "cds": {
    "requires": {
      "html5-repo": true,
      "application-logging": true,
      "auth": "dummy",
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}
